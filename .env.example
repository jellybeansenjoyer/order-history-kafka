# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=9092
ORDER_EVENTS_TOPIC=order-events
ORDER_EVENTS_PARTITIONS=6
ORDER_EVENTS_REPLICATION=1

# Service ports (host)
CHECKOUT_SIMULATOR_PORT=8101
SUPPORT_API_PORT=8102
FRAUD_SCORER_PORT=8103
SUPPORT_UI_PORT=5173
KAFKA_UI_PORT=8080

# Simulator defaults
SIMULATOR_AUTO_START=false
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_ORDERS_PER_BURST=1
